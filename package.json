{
  "name": "xianjian-guitar-platform",
  "version": "1.0.0",
  "private": true,
  "description": "弦间 - 抖音小程序吉他谱与直播回放内容平台（Express + MySQL + TOS + Web 管理后台）",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "tos:check": "node scripts/tos-upload-check.js",
    "admin:password": "node server/set-admin-password.js",
    "check": "node --check server.js && node --check server/index.js && node --check server/app.js",
    "docker:build": "docker build --platform linux/amd64 -t guitar-platform:local .",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@volcengine/tos-sdk": "^2.9.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "mysql-memory-server": "^1.17.0"
  }
}
