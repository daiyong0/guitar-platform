.videos-page {
  background:
    radial-gradient(circle at 100% 0, rgba(208, 168, 112, 0.12), transparent 34%),
    #f7f2e8;
}

.video-hero {
  position: relative;
  overflow: hidden;
  margin: 22rpx 26rpx 0;
  padding: 38rpx 32rpx 42rpx;
  color: #faf4e8;
  background:
    radial-gradient(circle at 86% 10%, rgba(228, 172, 115, 0.2), transparent 32%),
    linear-gradient(148deg, #25372c, #1b2922 72%);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 40rpx rgba(31, 41, 34, 0.16);
}
.hero-ring {
  position: absolute;
  top: -150rpx;
  right: -150rpx;
  width: 460rpx;
  height: 460rpx;
  border: 1rpx solid rgba(246, 235, 220, 0.08);
  border-radius: 50%;
  box-shadow: 0 0 0 48rpx rgba(246, 235, 220, 0.024), 0 0 0 96rpx rgba(246, 235, 220, 0.016);
}
.hero-copy {
  position: relative;
  z-index: 2;
  max-width: 72%;
}
.eyebrow {
  color: #dab188;
}
.video-hero-title {
  margin-top: 24rpx;
  color: #fbf5e9;
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.28;
  letter-spacing: 2rpx;
}
.video-hero-title.accent {
  margin-top: 2rpx;
  color: #e5b489;
}
.video-hero-sub {
  max-width: 450rpx;
  margin-top: 17rpx;
  color: rgba(244, 233, 218, 0.43);
  font-size: 21rpx;
  line-height: 1.8;
}
.hero-play {
  position: absolute;
  right: 48rpx;
  top: 158rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 114rpx;
  height: 114rpx;
  border: 1rpx solid rgba(249, 236, 218, 0.16);
  border-radius: 50%;
  background: rgba(255, 248, 236, 0.06);
  box-shadow: 0 0 0 18rpx rgba(255, 248, 236, 0.025);
}
.hero-play-tri {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 28rpx solid #e2b58c;
}
.hero-caption {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  color: rgba(242, 231, 214, 0.28);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 15rpx;
  letter-spacing: 2rpx;
}

.category-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
}
.category-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 26rpx;
}
.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 26rpx;
  color: #8d8376;
  background: rgba(255, 253, 248, 0.72);
  border: 1rpx solid #e9dfd1;
  border-radius: 29rpx;
  font-size: 23rpx;
  white-space: nowrap;
}
.category-chip.is-active {
  color: #fff8ef;
  background: #26372d;
  border-color: #26372d;
  box-shadow: 0 8rpx 16rpx rgba(30, 44, 36, 0.13);
}

.videos-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 34rpx 28rpx 20rpx;
}
.videos-label {
  color: #bd8e65;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 16rpx;
  letter-spacing: 4rpx;
}
.videos-title {
  margin-top: 3rpx;
  color: #24322a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
}
.videos-count {
  padding-bottom: 5rpx;
  color: #a19686;
  font-size: 20rpx;
}

.video-list {
  padding: 0 26rpx;
}
.video-card {
  margin-bottom: 24rpx;
  overflow: hidden;
  background: #fffdf8;
  border: 1rpx solid #ece2d4;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(70, 52, 30, 0.055);
}
.video-cover-wrap {
  position: relative;
  width: 100%;
  height: 358rpx;
  overflow: hidden;
  background: #e5dccd;
}
.video-cover {
  width: 100%;
  height: 100%;
}
.video-cover-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(14, 20, 16, 0.24) 0%, rgba(14, 20, 16, 0.02) 36%, rgba(14, 20, 16, 0.54) 100%);
}
.video-category {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  padding: 4rpx 14rpx;
  color: rgba(255, 248, 238, 0.9);
  background: rgba(29, 39, 32, 0.54);
  border: 1rpx solid rgba(255, 249, 238, 0.16);
  border-radius: 8rpx;
  font-size: 18rpx;
  backdrop-filter: blur(6rpx);
}
.video-time {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
  padding: 2rpx 10rpx;
  color: rgba(255, 248, 238, 0.9);
  background: rgba(23, 30, 25, 0.58);
  border-radius: 5rpx;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 17rpx;
}
.video-play {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-top: -46rpx;
  margin-left: -46rpx;
  background: rgba(255, 250, 243, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 18, 0.18);
}
.play-tri {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #26352c;
}
.cover-play-line {
  position: absolute;
  bottom: 17rpx;
  left: 18rpx;
  color: rgba(255, 247, 235, 0.46);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 14rpx;
  letter-spacing: 3rpx;
}
.video-card-body {
  padding: 20rpx 22rpx 21rpx;
}
.video-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: #26332b;
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.48;
  letter-spacing: 0.5rpx;
}
.video-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 11rpx;
  color: #a3988a;
  font-size: 19rpx;
}
.meta-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #c1b5a6;
}
.video-arrow {
  display: flex;
  align-items: center;
  margin-left: auto;
  color: #b5a898;
}
.video-arrow .chevron {
  width: 9rpx;
  height: 9rpx;
  border-width: 2rpx;
}

.video-skeleton-wrap {
  padding: 0 26rpx;
}
.video-skeleton {
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #fffdf8;
  border: 1rpx solid #eee4d6;
  border-radius: 24rpx;
}
.sk-video-cover {
  width: 100%;
  height: 358rpx;
  border-radius: 0;
}
.sk-video-copy {
  padding: 24rpx 22rpx;
}
.sk-video-title {
  width: 76%;
  height: 30rpx;
}
.sk-video-meta {
  width: 38%;
  height: 19rpx;
  margin-top: 17rpx;
}

.video-load-state {
  padding: 0 26rpx 26rpx;
}
.video-more {
  padding: 20rpx;
  color: #ada294;
  font-size: 20rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
.video-end {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 22rpx 0 8rpx;
  color: #b1a596;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 15rpx;
  letter-spacing: 2rpx;
}
.end-line {
  width: 64rpx;
  height: 1rpx;
  background: #ded4c5;
}
