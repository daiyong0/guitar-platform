.scores-page {
  background:
    radial-gradient(circle at 100% 14%, rgba(213, 174, 122, 0.13), transparent 34%),
    #f7f2e8;
}

.hero {
  position: relative;
  overflow: hidden;
  margin: 22rpx 26rpx 0;
  padding: 38rpx 32rpx 30rpx;
  color: #f8f1e5;
  background:
    radial-gradient(circle at 92% 5%, rgba(224, 167, 112, 0.2), transparent 36%),
    linear-gradient(145deg, #23332b 0%, #1c2a24 66%, #273a30 100%);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 40rpx rgba(36, 43, 36, 0.16);
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(247, 236, 219, 0.09);
  border-radius: 50%;
  pointer-events: none;
}
.orbit-one {
  top: -120rpx;
  right: -150rpx;
  width: 430rpx;
  height: 430rpx;
  box-shadow: 0 0 0 42rpx rgba(247, 236, 219, 0.025), 0 0 0 84rpx rgba(247, 236, 219, 0.018);
}
.orbit-two {
  right: 44rpx;
  bottom: -210rpx;
  width: 300rpx;
  height: 300rpx;
  opacity: 0.55;
}

.hero-strings {
  position: absolute;
  right: -40rpx;
  top: 150rpx;
  width: 330rpx;
  height: 330rpx;
  transform: rotate(-18deg);
  opacity: 0.28;
}
.hero-string {
  position: absolute;
  left: 0;
  width: 100%;
  height: 1rpx;
  background: #eadbc4;
  transform-origin: left center;
}
.hs1 { top: 0; transform: rotate(8deg); }
.hs2 { top: 48rpx; transform: rotate(11deg); }
.hs3 { top: 96rpx; transform: rotate(14deg); }
.hs4 { top: 144rpx; transform: rotate(17deg); }
.hs5 { top: 192rpx; transform: rotate(20deg); }
.hs6 { top: 240rpx; transform: rotate(23deg); }

.hero-topline {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #d9b48b;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}
.brand-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #e0a06d;
}
.hero-no {
  color: rgba(247, 236, 219, 0.32);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  position: relative;
  z-index: 2;
  margin-top: 34rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.22;
  letter-spacing: 2rpx;
  color: #fbf5e9;
}
.hero-title-accent {
  margin-top: 2rpx;
  color: #e8b98f;
}
.hero-subline {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  color: rgba(241, 230, 214, 0.43);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.hero-search {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-top: 30rpx;
  padding: 0 10rpx 0 24rpx;
  background: rgba(255, 252, 246, 0.96);
  border: 1rpx solid rgba(255, 248, 236, 0.2);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 24rpx rgba(8, 16, 11, 0.14);
}
.search-icon {
  position: relative;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
}
.search-circle {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 19rpx;
  height: 19rpx;
  border: 3rpx solid #9c9182;
  border-radius: 50%;
}
.search-handle {
  position: absolute;
  right: 2rpx;
  bottom: 4rpx;
  width: 12rpx;
  height: 3rpx;
  background: #9c9182;
  border-radius: 3rpx;
  transform: rotate(45deg);
}
.hero-search-input {
  flex: 1;
  height: 82rpx;
  color: #2e3a32;
  font-size: 25rpx;
}
.search-placeholder {
  color: #b0a597;
}
.search-clear {
  flex: 0 0 38rpx;
  width: 38rpx;
  height: 48rpx;
  color: #a79b8c;
  font-size: 36rpx;
  line-height: 44rpx;
  text-align: center;
}
.search-submit {
  flex: 0 0 auto;
  height: 60rpx;
  padding: 0 22rpx;
  color: #fff7ed;
  background: #d25d34;
  border-radius: 13rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.filter-wrap {
  padding: 26rpx 0 0;
}
.filter-scroll {
  width: 100%;
  white-space: nowrap;
}
.filter-row {
  display: inline-flex;
  padding: 0 26rpx;
  gap: 12rpx;
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 26rpx;
  color: #8d8376;
  background: rgba(255, 253, 248, 0.72);
  border: 1rpx solid #e9dfd1;
  border-radius: 29rpx;
  font-size: 23rpx;
  white-space: nowrap;
  transition: all 0.18s;
}
.filter-chip.is-active {
  color: #fff8ef;
  background: #24352c;
  border-color: #24352c;
  box-shadow: 0 8rpx 16rpx rgba(30, 44, 36, 0.14);
  font-weight: 500;
}

.library-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 34rpx 28rpx 20rpx;
}
.library-label {
  color: #bd8e65;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 16rpx;
  letter-spacing: 4rpx;
}
.library-title {
  margin-top: 3rpx;
  color: #24322a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.4;
}
.library-meta {
  padding-bottom: 5rpx;
  color: #a19686;
  font-size: 20rpx;
}
.result-tip {
  margin: -8rpx 28rpx 20rpx;
  color: #977a62;
  font-size: 21rpx;
}

.score-grid,
.score-skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 26rpx;
}
.score-card,
.score-skeleton {
  width: 48.3%;
  margin-bottom: 22rpx;
  overflow: hidden;
  background: #fffdf8;
  border: 1rpx solid #eee4d6;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 26rpx rgba(73, 55, 33, 0.05);
}
.score-card {
  animation: fade-up 0.34s ease both;
}
.score-card:nth-child(2) { animation-delay: 0.04s; }
.score-card:nth-child(3) { animation-delay: 0.08s; }
.score-card:nth-child(4) { animation-delay: 0.12s; }

.cover-wrap {
  position: relative;
  width: 100%;
  height: 410rpx;
  overflow: hidden;
  background: #e9dfd0;
}
.score-cover {
  width: 100%;
  height: 100%;
}
.cover-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(20, 25, 21, 0.02) 42%, rgba(18, 24, 20, 0.64) 100%);
}
.cover-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 13rpx;
  color: #fff8ee;
  background: rgba(34, 43, 37, 0.58);
  border: 1rpx solid rgba(255, 249, 239, 0.18);
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
  backdrop-filter: blur(6rpx);
}
.cover-pages {
  position: absolute;
  right: 15rpx;
  bottom: 15rpx;
  z-index: 2;
  color: rgba(255, 249, 239, 0.9);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}
.cover-strings {
  position: absolute;
  left: -10rpx;
  right: -10rpx;
  bottom: 42rpx;
  height: 80rpx;
  opacity: 0.22;
  transform: rotate(-9deg);
}
.cover-line {
  position: absolute;
  left: 0;
  width: 100%;
  height: 1rpx;
  background: #fff8ed;
}
.cl1 { top: 0; }
.cl2 { top: 28rpx; }
.cl3 { top: 56rpx; }

.score-card-body {
  padding: 17rpx 18rpx 16rpx;
}
.score-card-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 72rpx;
  color: #26332b;
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
}
.score-card-tags {
  display: flex;
  gap: 6rpx;
  margin-top: 8rpx;
  height: 30rpx;
  overflow: hidden;
}
.mini-tag {
  padding: 1rpx 8rpx;
  color: #a3856e;
  background: #faf3e9;
  border-radius: 5rpx;
  font-size: 16rpx;
  line-height: 1.65;
}
.score-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1e9de;
}
.meta-views {
  color: #a99e90;
  font-size: 18rpx;
}
.meta-arrow {
  display: flex;
  align-items: center;
  color: #b8ac9c;
}
.meta-arrow .chevron {
  width: 9rpx;
  height: 9rpx;
  border-width: 2rpx;
}

.score-skeleton {
  padding-bottom: 20rpx;
}
.sk-cover {
  width: 100%;
  height: 410rpx;
  border-radius: 0;
}
.sk-body {
  padding: 20rpx 18rpx 0;
}
.sk-title {
  width: 80%;
  height: 26rpx;
}
.sk-meta {
  width: 48%;
  height: 18rpx;
  margin-top: 16rpx;
}

.load-state {
  padding: 6rpx 28rpx 24rpx;
}
.more-hint {
  padding: 22rpx;
  color: #ada294;
  font-size: 20rpx;
  text-align: center;
  letter-spacing: 1rpx;
}
.end-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 22rpx 0 10rpx;
  color: #b0a597;
  font-size: 19rpx;
  letter-spacing: 2rpx;
}
.end-rule {
  width: 74rpx;
  height: 1rpx;
  background: #ded4c5;
}
